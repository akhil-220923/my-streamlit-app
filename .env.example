# IBVAP — Environment Credentials Template
# Copy this file to .env and fill in your connection URIs

# MongoDB Atlas Connection URI (TLS Enabled)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/IBVAP?retryWrites=true&w=majority

# Supabase API Credentials (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
